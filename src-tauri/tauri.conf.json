{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "toGp",
  "version": "0.1.0",
  "identifier": "com.togp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "toGp",
        "width": 640,
        "height": 420,
        "minWidth": 480,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' asset: data: tauri:; media-src 'self' data: blob: tauri:; connect-src 'self' ipc: http://ipc.localhost tauri: http://tauri.localhost https://tauri.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": [
      "resources/audiveris-runtime.zip",
      "resources/legal",
      "resources/tessdata"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
