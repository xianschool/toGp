{
  "name": "togp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "npm run test:models && npm run test:audit",
    "test:source-model": "python3 scripts/score-source-model.test.py",
    "test:tab-model": "python3 scripts/tab-score-model.test.py",
    "test:models": "npm run test:source-model && npm run test:tab-model",
    "test:audit": "node --test scripts/audit-score.test.mjs",
    "tauri": "tauri",
    "audit:score": "node scripts/audit-score.mjs",
    "inspect:score-source": "node scripts/inspect-score-source.mjs",
    "prepare:tab-converter": "node scripts/prepare-tab-converter.mjs",
    "desktop:dev": "npm run prepare:tab-converter && tauri dev",
    "desktop:build": "npm run prepare:tab-converter && node scripts/package-macos.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
